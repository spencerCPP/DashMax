<settings>
  <setting propertyKey="@Properties.ActivityData" title="@Strings.ActivityDataTitle">
    <settingConfig type="boolean" />
  </setting>
  <setting propertyKey="@Properties.Dark" title="@Strings.DarkTitle">
    <settingConfig type="boolean" />
  </setting>
  <setting propertyKey="@Properties.Animate" title="@Strings.AnimateTitle">
    <settingConfig type="boolean" />
  </setting>
  <setting propertyKey="@Properties.RideScenario" title="@Strings.RideTitle">
    <settingConfig type="list">
      <listEntry value="0">@Strings.NormalRide</listEntry>
      <listEntry value="1">@Strings.LongRide</listEntry>
      <listEntry value="2">@Strings.UltraRide</listEntry>
      <listEntry value="3">@Strings.ThousandRide</listEntry>
      <listEntry value="4">@Strings.ThousandMilesRide</listEntry>
    </settingConfig>
  </setting>
  <setting propertyKey="@Properties.SensorState" title="@Strings.SensorTitle">
    <settingConfig type="list">
      <listEntry value="0">@Strings.Connected</listEntry>
      <listEntry value="1">@Strings.Missing</listEntry>
      <listEntry value="2">@Strings.Stopped</listEntry>
    </settingConfig>
  </setting>
</settings>